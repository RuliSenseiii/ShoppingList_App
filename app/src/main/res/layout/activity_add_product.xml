<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:ignore="ContentDescription">

    <include layout="@layout/view_top_bar" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvTarget"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:background="@drawable/bg_pill_orange"
                android:drawablePadding="8dp"
                android:gravity="center_vertical"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:textColor="@color/orange_dark"
                android:textSize="15sp"
                android:textStyle="bold"
                app:drawableStartCompat="@drawable/ic_list"
                app:drawableTint="@color/orange" />

            <!-- Form card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_plain"
                android:elevation="3dp"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/form_title"
                    android:textColor="@color/green_dark"
                    android:textSize="19sp"
                    android:textStyle="bold" />

                <LinearLayout style="@style/InputRow">

                    <ImageView
                        style="@style/InputRowIcon"
                        android:src="@drawable/ic_label" />

                    <EditText
                        android:id="@+id/etName"
                        style="@style/InputRowField"
                        android:importantForAutofill="no"
                        android:hint="@string/product_name_hint"
                        android:inputType="textCapSentences" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/categoryRow"
                    style="@style/InputRow">

                    <ImageView
                        style="@style/InputRowIcon"
                        android:src="@drawable/ic_category" />

                    <Spinner
                        android:id="@+id/spCategory"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:spinnerMode="dropdown" />

                    <ImageView
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:importantForAccessibility="no"
                        android:rotation="90"
                        android:src="@drawable/ic_chevron_right"
                        app:tint="@color/green_mid" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/quantityRow"
                    style="@style/InputRow"
                    android:visibility="gone">

                    <ImageView
                        style="@style/InputRowIcon"
                        android:src="@drawable/ic_scale" />

                    <EditText
                        android:id="@+id/etQuantity"
                        style="@style/InputRowField"
                        android:importantForAutofill="no"
                        android:inputType="number" />

                    <TextView
                        android:id="@+id/tvUnit"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:textColor="@color/orange_dark"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAdd"
                    style="@style/GradientButton"
                    android:layout_width="match_parent"
                    android:layout_marginTop="16dp"
                    android:text="@string/add"
                    android:visibility="gone"
                    app:icon="@drawable/ic_add" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvCurrentTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/current_products"
                android:textAllCaps="true"
                android:letterSpacing="0.06"
                android:textColor="@color/text_muted"
                android:textSize="13sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
