<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:ignore="ContentDescription,NestedWeights">

    <!-- Gradient header; id topBar so it extends under the status bar. -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_main"
        android:elevation="6dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="18dp"
        android:paddingEnd="24dp"
        android:paddingBottom="24dp">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="68dp">

            <FrameLayout
                android:layout_width="68dp"
                android:layout_height="68dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_icon_circle_light">

                <ImageView
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_cart" />
            </FrameLayout>

            <!-- Settings: backup and category order. -->
            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="start|top"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/settings_open"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_settings" />

            <!-- Always-available entrance to the tutorial. -->
            <ImageButton
                android:id="@+id/btnTutorial"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_gravity="end|top"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/tutorial_help"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_help" />
        </FrameLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="@string/main_header"
            android:textColor="@color/white"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:alpha="0.85"
            android:gravity="center"
            android:text="@string/main_subtitle"
            android:textColor="@color/white"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:clipToPadding="false"
        android:paddingBottom="16dp">

        <LinearLayout
            android:id="@+id/bannerMyLists"
            style="@style/MainBanner"
            android:background="@drawable/bg_banner_green">

            <FrameLayout
                style="@style/MainBannerIconCircle"
                android:background="@drawable/bg_icon_circle_green">

                <ImageView
                    style="@style/MainBannerIcon"
                    android:src="@drawable/ic_list" />
            </FrameLayout>

            <LinearLayout style="@style/MainBannerTexts">

                <TextView
                    style="@style/MainBannerTitle"
                    android:text="@string/banner_my_lists"
                    android:textColor="@color/green_dark" />

                <TextView
                    android:id="@+id/tvMyListsSub"
                    style="@style/MainBannerSubtitle" />
            </LinearLayout>

            <ImageView
                style="@style/MainBannerChevron"
                app:tint="@color/green_mid" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bannerNewList"
            style="@style/MainBanner"
            android:background="@drawable/bg_banner_orange">

            <FrameLayout
                style="@style/MainBannerIconCircle"
                android:background="@drawable/bg_icon_circle_orange">

                <ImageView
                    style="@style/MainBannerIcon"
                    android:src="@drawable/ic_playlist_add" />
            </FrameLayout>

            <LinearLayout style="@style/MainBannerTexts">

                <TextView
                    style="@style/MainBannerTitle"
                    android:text="@string/banner_new_list"
                    android:textColor="@color/orange_dark" />

                <TextView
                    style="@style/MainBannerSubtitle"
                    android:text="@string/banner_new_list_sub" />
            </LinearLayout>

            <ImageView
                style="@style/MainBannerChevron"
                app:tint="@color/orange" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bannerAddProduct"
            style="@style/MainBanner"
            android:background="@drawable/bg_banner_green">

            <FrameLayout
                style="@style/MainBannerIconCircle"
                android:background="@drawable/bg_icon_circle_green">

                <ImageView
                    style="@style/MainBannerIcon"
                    android:src="@drawable/ic_add_circle" />
            </FrameLayout>

            <LinearLayout style="@style/MainBannerTexts">

                <TextView
                    style="@style/MainBannerTitle"
                    android:text="@string/banner_add_product"
                    android:textColor="@color/green_dark" />

                <TextView
                    android:id="@+id/tvAddProductSub"
                    style="@style/MainBannerSubtitle" />
            </LinearLayout>

            <ImageView
                style="@style/MainBannerChevron"
                app:tint="@color/green_mid" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/bannerHome"
            style="@style/MainBanner"
            android:background="@drawable/bg_banner_orange">

            <FrameLayout
                style="@style/MainBannerIconCircle"
                android:background="@drawable/bg_icon_circle_orange">

                <ImageView
                    style="@style/MainBannerIcon"
                    android:src="@drawable/ic_home" />
            </FrameLayout>

            <LinearLayout style="@style/MainBannerTexts">

                <TextView
                    style="@style/MainBannerTitle"
                    android:text="@string/banner_home"
                    android:textColor="@color/orange_dark" />

                <TextView
                    android:id="@+id/tvHomeSub"
                    style="@style/MainBannerSubtitle" />
            </LinearLayout>

            <ImageView
                style="@style/MainBannerChevron"
                app:tint="@color/orange" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/btnGoShopping"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginStart="8dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="8dp"
            android:layout_marginBottom="6dp"
            android:layout_weight="1.05"
            android:background="@drawable/bg_big_button"
            android:clickable="true"
            android:elevation="8dp"
            android:focusable="true"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_cart" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:letterSpacing="0.04"
                android:text="@string/go_shopping"
                android:textColor="@color/white"
                android:textSize="26sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
